# --- Backend ---
# URL of your deployed FastAPI RAG backend (Hugging Face Space).
# No NEXT_PUBLIC_ prefix on purpose — this is only ever called server-side now.
API_URL=http://localhost:7860

# Shared secret with the backend's BACKEND_API_KEY (see backend/.env or its
# HF Space secrets). Must match exactly. Leave both unset for local dev.
BACKEND_API_KEY=

# --- Database (Neon, free tier: https://neon.tech) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                           https://<your-domain>/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
